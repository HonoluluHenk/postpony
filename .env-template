APP_DB_URL=file:./data/postpony.db
APP_DB_AUTH_TOKEN=CHANGEME-unused-for-file-urls
# Set to false to serve plain HTTP behind Cloudflare edge TLS / a reverse proxy.
APP_TLS_ENABLED=true
# Port of the Playwright-managed e2e test server (playwright.config.ts).
# playwright.config.ts loads .env itself, so uncommenting this sets the port
# E2E_APP_PORT=3001
