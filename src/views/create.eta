<% if (!it.isPartial) { %>
<% layout('./layouts/main.eta') %>
<% } %>

<section class="card">
  <h2><%= it.t('create_reschedule_title') %></h2>

  <form hx-post="/create" hx-target="body" hx-push-url="true">
    <div class="form-group">
      <label for="reschedule-name"><%= it.t('reschedule_name') %></label>
      <input type="text" id="reschedule-name" name="name" required aria-required="true"
             value="<%= it.values?.name || '' %>"
             <% if (it.errors?.name) { %> aria-invalid="true" aria-describedby="name-error" <% } %>>
      <% if (it.errors?.name) { %>
        <span id="name-error" class="error-message" role="alert"><%= it.errors.name %></span>
      <% } %>
    </div>
    <button type="submit"><%= it.t('create_button') %></button>
  </form>
</section>
