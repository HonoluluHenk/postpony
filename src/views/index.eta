<% layout('./layouts/main.eta') %>

<section class="padding small-round surface-variant">
  <header>
    <h2 class="center-align"><%= it.t('welcome') %></h2>
    <p class="center-align"><%= it.t('tagline') %></p>
  </header>

  <nav class="center-align mt-4">
    <button hx-get="/create" hx-target="#main-content" hx-swap="innerHTML"><%= it.t('create_new') %></button>
    <button class="outline" hx-get="/edit" hx-target="#main-content" hx-swap="innerHTML"><%= it.t('edit_existing') %></button>
  </nav>
</section>
