<% if (!it.isPartial) { %>
<% layout('./layouts/main.eta') %>
<% } %>

<h2>Editing ReSchedule: <%= it.session.name %></h2>

<% if (it.ownerPassword) { %>
  <div class="alert" role="alert">
    <p>ReSchedule created successfully!</p>
    <p>Your <strong>Owner Password</strong> is: <span class="password-display"><%= it.ownerPassword %></span></p>
    <p>Please save this password. You will need it to edit this ReSchedule later.</p>
  </div>
<% } %>

<p>Status: <%= it.session.status %></p>
<p>Invite participants using this link: <a href="/join/<%= it.session.id %>">/join/<%= it.session.id %></a></p>

<h3>Scheduling Engine Info</h3>

<div id="scheduling-info">
  <section id="venue-management">
    <h4>Venue Management</h4>
    <form hx-post="/edit/<%= it.session.id %>/venue" hx-target="#venue-management" hx-swap="outerHTML">
      <div class="form-group">
        <label for="maxOverlaps">Maximum Overlapping Matches (for this session)</label>
        <input type="number" id="maxOverlaps" name="maxOverlaps" value="<%= it.session.maxOverlaps || '' %>" min="0">
      </div>
      <button type="submit">Update Venue Settings</button>
    </form>
  </section>

  <hr>

  <section id="team-management">
    <h4>Home Team Players</h4>
    <ul id="player-list">
      <% it.session.players.forEach(player => { %>
        <li><%= player.name %></li>
      <% }) %>
    </ul>
    <form hx-post="/edit/<%= it.session.id %>/players" hx-target="#team-management" hx-swap="outerHTML">
      <div class="form-group">
        <label for="playerName">New Player Name</label>
        <input type="text" id="playerName" name="playerName" required>
      </div>
      <button type="submit">Add Player</button>
    </form>
  </section>
</div>
