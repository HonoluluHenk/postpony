<% if (!it.isPartial) { %>
<!DOCTYPE html>
<html lang="<%= it.locale %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title %></title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <script src="/vendor/js/htmx.min.js"></script>
  <link rel="stylesheet" href="/vendor/css/beer.min.css">
  <script type="module" src="/vendor/js/beer.min.js"></script>
  <script type="module" src="/vendor/js/material-dynamic-colors.min.js"></script>
  <script src="/js/main.js"></script>
  <style>
    :root {
      --primary: #1a237e;
    }
  </style>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="light">
  <a href="#main-content" class="skip-link"><%= it.t('skip_to_main') %></a>
  <div class="container">
    <header class="padding">
      <div class="row no-wrap">
        <h1 class="max center-align"><%= it.title %></h1>
        <nav class="row no-wrap shrink" aria-label="<%= it.t('language_selection') %>">
          <a class="button circle transparent" href="?lang=en" title="<%= it.t('language_en') %>">
            <i><img src="/vendor/img/flags/gb.svg" width="20" alt="<%= it.t('language_en') %>"></i>
          </a>
          <a class="button circle transparent" href="?lang=de" title="<%= it.t('language_de') %>">
            <i><img src="/vendor/img/flags/de.svg" width="20" alt="<%= it.t('language_de') %>"></i>
          </a>
        </nav>
      </div>
    </header>
    <main id="main-content" class="responsive">
      <article>
        <%~ it.body %>
      </article>
    </main>
    <footer class="padding center-align">
      <p>&copy; 2024 Game Postponer</p>
    </footer>
  </div>
</body>
</html>
<% } else { %>
  <%~ it.body %>
<% } %>
