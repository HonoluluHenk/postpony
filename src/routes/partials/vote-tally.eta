<% if (it.proposedDates.length > 0) { %>
  <h<%= it.headingLevel || 3 %> id="<%= it.titleId || 'vote-tally-title' %>"><%= it.title || it.t('vote_summary') %></h<%= it.headingLevel || 3 %>>
  <table>
    <caption><%= it.title || it.t('vote_summary') %></caption>
    <thead>
      <tr>
        <th scope="col"><%= it.t('proposed_date_time_label') %></th>
        <th scope="col"><%= it.t('vote_yes') %></th>
        <th scope="col"><%= it.t('vote_maybe') %></th>
        <th scope="col"><%= it.t('vote_no') %></th>
      </tr>
    </thead>
    <tbody>
      <% it.proposedDates.forEach(function (pd) { %>
        <tr>
          <td data-label="<%= it.t('proposed_date_time_label') %>"><%= pd.display %></td>
          <td data-label="<%= it.t('vote_yes') %>"><%= pd.yes %></td>
          <td data-label="<%= it.t('vote_maybe') %>"><%= pd.maybe %></td>
          <td data-label="<%= it.t('vote_no') %>"><%= pd.no %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
