<% layout('../layouts/main.eta') %>

<section id="create-section" class="padding small-round surface-variant">
  <header>
    <h2><%= it.t('create_postponement_title') %></h2>
  </header>

  <form action="/create" method="post">
    <div class="field label border fill <%= it.errors?.fields?.homeTeam ? 'invalid' : '' %>">
      <input type="text" id="home-team" name="homeTeam" required aria-required="true"
             value="<%= it.values?.homeTeam || '' %>"
             <% if (it.errors?.fields?.homeTeam) { %> aria-invalid="true" aria-describedby="home-team-error" <% } %>>
      <label for="home-team"><%= it.t('home_team') %></label>
      <span id="home-team-error" class="error" role="alert"><%= it.errors?.fields?.homeTeam || '' %></span>
    </div>
    <div class="field label border fill <%= it.errors?.fields?.guestTeam ? 'invalid' : '' %>">
      <input type="text" id="guest-team" name="guestTeam" required aria-required="true"
             value="<%= it.values?.guestTeam || '' %>"
             <% if (it.errors?.fields?.guestTeam) { %> aria-invalid="true" aria-describedby="guest-team-error" <% } %>>
      <label for="guest-team"><%= it.t('guest_team') %></label>
      <span id="guest-team-error" class="error" role="alert"><%= it.errors?.fields?.guestTeam || '' %></span>
    </div>
    <div class="field label border fill <%= it.errors?.fields?.originalMatchDateTime ? 'invalid' : '' %>">
      <input type="text" id="original-match-date-time" name="originalMatchDateTime"
             value="<%= it.values?.originalMatchDateTime || '' %>" required aria-required="true"
             placeholder="<%= it.inputFormat %>" lang="<%= it.locale %>" autocomplete="off"
             <% if (it.errors?.fields?.originalMatchDateTime) { %> aria-invalid="true" aria-describedby="original-match-date-time-error" <% } %>>
      <label for="original-match-date-time"><%= it.t('original_match_date_time_label') %></label>
      <span id="original-match-date-time-error" class="error" role="alert"><%= it.errors?.fields?.originalMatchDateTime || '' %></span>
    </div>
    <div class="right-align">
      <button type="submit"><%= it.t('create_button') %></button>
    </div>
  </form>
</section>
