<% layout('../../layouts/main.eta') %>

<section id="create-section" class="padding small-round surface-variant">
  <header>
    <h2><%= it.t('scrape_choose_team') %></h2>
    <p>
      <strong><%= it.groupName %></strong>
      — <%= it.leagueName %>
    </p>
  </header>

  <% if (!it.teams || it.teams.length === 0) { %>
    <p><%= it.t('scrape_no_teams') %></p>
  <% } else { %>
    <ul class="list border" role="list">
      <% for (const team of it.teams) { %>
        <li>
          <% const meetingsQuery = `championship=${encodeURIComponent(team.championship)}&group=${encodeURIComponent(team.group)}&teamtable=${encodeURIComponent(team.teamtable)}&teamName=${encodeURIComponent(team.name)}&groupName=${encodeURIComponent(it.groupName || '')}&leagueName=${encodeURIComponent(it.leagueName || '')}` %>
          <a href="/create/scrape/meetings?<%= meetingsQuery %>">
            <%= team.name %>
          </a>
        </li>
      <% } %>
    </ul>
  <% } %>

  <div class="right-align">
    <% const groupsQuery = `championship=${encodeURIComponent(it.championship || '')}&leagueName=${encodeURIComponent(it.leagueName || '')}` %>
    <a href="/create/scrape/groups?<%= groupsQuery %>">
      <%= it.t('scrape_back') %>
    </a>
  </div>
</section>
