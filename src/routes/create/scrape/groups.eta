<% layout('../../layouts/main.eta') %>

<section id="create-section" class="padding small-round surface-variant">
  <header>
    <h2><%= it.t('scrape_choose_group') %></h2>
    <p><strong><%= it.leagueName %></strong></p>
  </header>

  <% if (!it.groups || it.groups.length === 0) { %>
    <p><%= it.t('scrape_no_groups') %></p>
  <% } else { %>
    <ul class="list border">
      <% for (const group of it.groups) { %>
        <li>
          <% const teamsQuery = `championship=${encodeURIComponent(group.championship)}&group=${encodeURIComponent(group.group)}&groupName=${encodeURIComponent(group.name)}&leagueName=${encodeURIComponent(it.leagueName || '')}` %>
          <a href="/create/scrape/teams?<%= teamsQuery %><%= it.changeSuffix %>">
            <%= group.name %>
          </a>
        </li>
      <% } %>
    </ul>
  <% } %>

  <div class="right-align">
    <% if (it.changeMode) { %>
      <a href="/edit/<%= it.sessionId %>?ownerPassword=<%= it.ownerPassword %>">
        <%= it.t('scrape_back') %>
      </a>
    <% } else { %>
      <a href="/create/scrape">
        <%= it.t('scrape_back') %>
      </a>
    <% } %>
  </div>
</section>
