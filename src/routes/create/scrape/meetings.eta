<% layout('../../layouts/main.eta') %>

<section id="create-section" class="padding small-round surface-variant">
  <header>
    <h2><%= it.t('scrape_choose_match') %></h2>
    <p>
      <strong><%= it.teamName %></strong>
      — <%= it.groupName %> — <%= it.leagueName %>
    </p>
  </header>

  <% if (!it.meetings || it.meetings.length === 0) { %>
    <p><%= it.t('scrape_no_meetings') %></p>
  <% } else { %>
    <table class="border">
      <caption><%= it.t('scrape_choose_match') %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.t('scrape_match_date') %></th>
          <th scope="col"><%= it.t('scrape_match_time') %></th>
          <th scope="col"><%= it.t('scrape_match_home') %></th>
          <th scope="col"><%= it.t('scrape_match_guest') %></th>
          <th scope="col"><span class="visually-hidden"><%= it.t('scrape_match_actions') %></span></th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < it.meetings.length; i++) { %>
          <% const m = it.meetings[i]; %>
          <tr>
            <td data-label="<%= it.t('scrape_match_date') %>"><%= m.day %> <%= m.date %></td>
            <td data-label="<%= it.t('scrape_match_time') %>"><%= m.time %></td>
            <td data-label="<%= it.t('scrape_match_home') %>"><%= m.homeTeam %></td>
            <td data-label="<%= it.t('scrape_match_guest') %>"><%= m.guestTeam %></td>
            <td data-label="<%= it.t('scrape_match_actions') %>">
              <form method="post" action="/create/scrape/meeting">
                <input type="hidden" name="day" value="<%= m.day %>">
                <input type="hidden" name="date" value="<%= m.date %>">
                <input type="hidden" name="time" value="<%= m.time %>">
                <input type="hidden" name="homeTeam" value="<%= m.homeTeam %>">
                <input type="hidden" name="guestTeam" value="<%= m.guestTeam %>">
                <input type="hidden" name="groupName" value="<%= it.groupName %>">
                <input type="hidden" name="leagueName" value="<%= it.leagueName %>">
                <input type="hidden" name="championship" value="<%= it.championship %>">
                <input type="hidden" name="group" value="<%= it.group %>">
                <input type="hidden" name="teamName" value="<%= it.teamName %>">
                <input type="hidden" name="opponentTeamtable" value="<%= m.opponentTeamtable %>">
                <% for (let j = 0; j < (it.players || []).length; j++) { %>
                  <input type="hidden" name="playerName" value="<%= it.players[j].name %>">
                <% } %>
                <button type="submit" class="small">
                  <%= it.t('scrape_create_session') %>
                </button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  <% } %>

  <div class="right-align">
    <% const teamsQuery = `championship=${encodeURIComponent(it.championship || '')}&group=${encodeURIComponent(it.group || '')}&groupName=${encodeURIComponent(it.groupName || '')}&leagueName=${encodeURIComponent(it.leagueName || '')}` %>
    <a href="/create/scrape/teams?<%= teamsQuery %>">
      <%= it.t('scrape_back') %>
    </a>
  </div>
</section>
