<% layout('../../layouts/main.eta') %>

<section id="create-section" class="padding small-round surface-variant">
  <header>
    <h2><%= it.t('scrape_choose_league') %></h2>
  </header>

  <% if (!it.leagues || it.leagues.length === 0) { %>
    <p><%= it.t('scrape_no_leagues') %></p>
  <% } else { %>
    <ul class="list border" role="list">
      <% for (const league of it.leagues) { %>
        <li>
          <% const groupsQuery = `championship=${encodeURIComponent(league.championship)}&leagueName=${encodeURIComponent(league.name)}` %>
          <a href="/create/scrape/groups?<%= groupsQuery %>">
            <%= league.name %>
          </a>
        </li>
      <% } %>
    </ul>
  <% } %>

  <nav class="right-align">
    <a href="/create">
      <%= it.t('scrape_back') %>
    </a>
  </nav>
</section>
