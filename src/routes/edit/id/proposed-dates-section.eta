<%~ include('../../partials/error-container.eta', {globalError: it.globalError}) %>
<section id="proposed-dates-management" class="padding small-round surface-variant s12 m4" aria-live="polite">
  <header>
    <h4 tabindex="-1"><%= it.t('proposed_dates_management') %></h4>
  </header>
  <ul id="proposed-date-list" class="list" aria-label="<%= it.t('proposed_dates_management') %>">
    <% it.proposedDates.forEach(function (proposedDate) { %>
      <li>
        <i>event</i>
        <div class="max"><%= proposedDate.display %></div>
        <label class="switch">
          <input type="checkbox"
                 hx-post="/edit/<%= it.sessionId %>/proposed-date-visibility?proposedDateId=<%= proposedDate.id %>&votable=<%= !proposedDate.awayTeamVotable %>"
                 hx-target="#proposed-dates-management"
                 <%= proposedDate.awayTeamVotable ? 'checked' : '' %>>
          <span><%= it.t('away_team_votable') %></span>
        </label>
      </li>
    <% }) %>
  </ul>
  <form hx-post="/edit/<%= it.sessionId %>/proposed-dates" hx-target="#proposed-dates-management" class="mt-4">
    <div class="field label border fill <%= it.error ? 'invalid' : '' %>">
      <% if (it.error) { %>
        <input type="datetime-local" id="proposedDateTime" name="proposedDateTime" value="<%= it.proposedDateTime %>" lang="de" aria-invalid="true" aria-describedby="proposedDateTime-error">
      <% } else { %>
        <input type="datetime-local" id="proposedDateTime" name="proposedDateTime" required lang="de">
      <% } %>
      <label for="proposedDateTime"><%= it.t('proposed_date_time_label') %></label>
      <% if (it.error) { %>
        <span id="proposedDateTime-error" class="error" role="alert"><%= it.error %></span>
      <% } %>
    </div>
    <div class="right-align">
      <button type="submit"><%= it.t('add_proposed_date') %></button>
    </div>
  </form>
  <% if (it.success) { %>
    <div class="toast success top" role="alert">
      <i aria-hidden="true">check_circle</i>
      <div class="max">
        <p><%= it.t('proposed_date_added') %></p>
      </div>
    </div>
  <% } %>
</section>

<div id="vote-tally-section" hx-swap-oob="true" class="grid" aria-live="polite">
  <section class="padding small-round surface-variant s12 m6" aria-label="<%= it.t('vote_summary_home') %>">
    <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_home'), proposedDates: it.homeProposedDates, t: it.t}) %>
  </section>
  <section class="padding small-round surface-variant s12 m6" aria-label="<%= it.t('vote_summary_away') %>">
    <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_away'), proposedDates: it.awayProposedDates, t: it.t}) %>
  </section>
</div>
