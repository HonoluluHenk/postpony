<%~ include('../../partials/error-container.eta', {globalError: it.globalError}) %>
<section id="proposed-dates-management" class="padding small-round surface-variant s12 m4" aria-live="polite">
  <header>
    <h3 tabindex="-1"><%= it.t('proposed_dates_management') %></h3>
  </header>
  <ul id="proposed-date-list" class="list" aria-label="<%= it.t('proposed_dates_management') %>">
    <% it.proposedDates.forEach(function (proposedDate) { %>
      <li>
        <i aria-hidden="true">event</i>
        <div class="max"><%= proposedDate.display %></div>
        <label class="switch">
          <input type="checkbox"
                 hx-post="/edit/<%= it.sessionId %>/proposed-date-visibility?proposedDateId=<%= proposedDate.id %>&votable=<%= !proposedDate.votableByOpponent %>"
                 hx-target="#proposed-dates-management"
                 <%= proposedDate.votableByOpponent ? 'checked' : '' %>>
          <span><%= it.t('votable_by_opponent') %></span>
        </label>
      </li>
    <% }) %>
  </ul>
  <form hx-post="/edit/<%= it.sessionId %>/proposed-dates" hx-target="#proposed-dates-management" class="mt-4">
    <div class="row items-center gap">
      <div class="field label border fill max <%= it.error ? 'invalid' : '' %>">
        <% if (it.error) { %>
          <input type="text" id="proposedDateTime" name="proposedDateTime" value="<%= it.proposedDateTime %>" aria-invalid="true" aria-describedby="proposedDateTime-error" placeholder="<%= it.inputFormat %>" lang="<%= it.locale %>" autocomplete="off">
        <% } else { %>
          <input type="text" id="proposedDateTime" name="proposedDateTime" value="<%= it.proposedDateTime || '' %>" required placeholder="<%= it.inputFormat %>" lang="<%= it.locale %>" autocomplete="off">
        <% } %>
        <label for="proposedDateTime"><%= it.t('proposed_date_time_label') %></label>
        <% if (it.error) { %>
          <span id="proposedDateTime-error" class="error" role="alert"><%= it.error %></span>
        <% } %>
      </div>
      <button type="button" id="proposedDateTimePicker" class="button" aria-label="<%= it.t('proposed_date_time_picker_label') %>" title="<%= it.t('proposed_date_time_picker_label') %>"><i aria-hidden="true">calendar_today</i></button>
    </div>
    <div class="right-align">
      <button type="submit"><%= it.t('add_proposed_date') %></button>
    </div>
  </form>
  <% if (it.success) { %>
    <div class="toast success top" role="alert">
      <i aria-hidden="true">check_circle</i>
      <div class="max">
        <p><%= it.t('proposed_date_added') %></p>
      </div>
    </div>
  <% } %>
</section>

<div id="vote-tally-section" hx-swap-oob="true" class="grid" aria-live="polite">
  <section class="padding small-round surface-variant s12 m6"<%~ it.homeProposedDates.length > 0 ? ' aria-labelledby="vote-summary-home-title"' : '' %>>
    <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_home'), titleId: 'vote-summary-home-title', proposedDates: it.homeProposedDates, t: it.t}) %>
  </section>
  <section class="padding small-round surface-variant s12 m6"<%~ it.awayProposedDates.length > 0 ? ' aria-labelledby="vote-summary-away-title"' : '' %>>
    <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_away'), titleId: 'vote-summary-away-title', proposedDates: it.awayProposedDates, t: it.t}) %>
  </section>
</div>
