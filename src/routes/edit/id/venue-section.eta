<%~ include('../../partials/error-container.eta', {globalError: it.globalError}) %>
<section id="venue-management" class="padding small-round surface-variant s12 m4">
  <header>
    <h4><%= it.t('venue_management') %></h4>
  </header>
  <form hx-post="/edit/<%= it.sessionId %>/venue" hx-target="#venue-management">
    <div class="field label border fill <%= it.error ? 'invalid' : '' %>">
      <input type="number" id="maxOverlaps" name="maxOverlaps" value="<%= it.maxOverlaps %>" min="0">
      <label for="maxOverlaps"><%= it.t('max_overlaps') %></label>
      <% if (it.error) { %>
        <span class="error" role="alert"><%= it.error %></span>
      <% } %>
    </div>
    <div class="right-align">
      <button type="submit"><%= it.t('update_venue_settings') %></button>
    </div>
  </form>
  <% if (it.success) { %>
    <div class="toast success top" role="alert">
      <i aria-hidden="true">check_circle</i>
      <div class="max">
        <p><%= it.t('venue_settings_updated') %></p>
      </div>
    </div>
  <% } %>
</section>
