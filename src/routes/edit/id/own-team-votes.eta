<section id="own-team-votes" class="padding small-round surface-variant"<%~ it.oob ? ' hx-swap-oob="true"' : '' %> aria-labelledby="own-team-votes-title" aria-live="polite">
  <header>
    <h<%= it.headingLevel || 3 %> id="own-team-votes-title"><%= it.title %></h<%= it.headingLevel || 3 %>>
  </header>
  <% if (it.ownTeamResults.length > 0) { %>
    <table>
      <caption><%= it.title %></caption>
      <thead>
        <tr>
          <th scope="col"><%= it.t('proposed_date_time_label') %></th>
          <% it.organizerPlayers.forEach(function (player) { %>
            <th scope="col"><%= player.name %></th>
          <% }) %>
          <th scope="col"><%= it.t('voted_column') %></th>
        </tr>
      </thead>
      <tbody>
        <% it.ownTeamResults.forEach(function (dateResult) { %>
          <tr>
            <th scope="row"><%= dateResult.display %></th>
            <% dateResult.votes.forEach(function (cell) { %>
              <td>
                <% if (cell.vote) { %>
                  <%= it.t('vote_' + cell.vote.toLowerCase()) %>
                <% } else { %>
                  <span class="visually-hidden"><%= it.t('no_vote') %></span><span aria-hidden="true">–</span>
                <% } %>
              </td>
            <% }) %>
            <td><%= it.t('voted_count', {voted: String(dateResult.voted), total: String(dateResult.total)}) %></td>
          </tr>
          <% if (dateResult.nonVoters.length > 0) { %>
            <tr>
              <td colspan="<%= dateResult.votes.length + 2 %>">
                <%= it.t('non_voters') %>
                <% dateResult.nonVoters.forEach(function (nonVoter, index) { %>
                  <% if (index > 0) { %>, <% } %><%= nonVoter.playerName %><% if (!nonVoter.joined) { %> (<%= it.t('not_joined') %>)<% } %>
                <% }) %>
              </td>
            </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</section>