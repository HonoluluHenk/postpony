<% layout('../../layouts/main.eta') %>

<header>
  <h2><%~ it.t('edit_reschedule_title', {name: it.session.name}) %></h2>
</header>

<% if (it.ownerPassword) { %>
  <div class="toast primary white-text top" role="alert">
    <i aria-hidden="true">info</i>
    <div class="max">
      <p><strong><%= it.t('reschedule_created_success') %></strong></p>
      <p><%~ it.t('owner_password_label') %> <span class="password-display"><%= it.ownerPassword %></span></p>
      <p><%= it.t('save_password_warning') %></p>
    </div>
  </div>
<% } %>

<section class="row items-center wrap">
  <p class="chip outline"><%= it.t('status_label', {status: it.session.status}) %></p>
</section>

<section>
  <p><%= it.t('invite_link_label') %></p>
  <ul class="list">
    <li>
      <div class="max">
        <span><%= it.t('invite_link_home_label') %></span>
        <a href="<%= it.baseUrl %>/join/<%= it.session.id %>/home?token=<%= it.invitationPassword %>" aria-label="<%= it.t('invite_link_home_label') %>"><%= it.baseUrl %>/join/<%= it.session.id %>/home?token=<%= it.invitationPassword %></a>
      </div>
    </li>
    <li>
      <div class="max">
        <span><%= it.t('invite_link_away_label') %></span>
        <a href="<%= it.baseUrl %>/join/<%= it.session.id %>/away?token=<%= it.invitationPassword %>" aria-label="<%= it.t('invite_link_away_label') %>"><%= it.baseUrl %>/join/<%= it.session.id %>/away?token=<%= it.invitationPassword %></a>
      </div>
    </li>
  </ul>
</section>

<section>
  <header>
    <h3><%= it.t('scheduling_engine_info') %></h3>
  </header>

  <div id="scheduling-info" class="grid">
    <section id="venue-management" class="padding small-round surface-variant s12 m4">
      <header>
        <h4><%= it.t('venue_management') %></h4>
      </header>
      <div>
        <a class="button"
           href="/create/scrape">
          <%= it.t('scrape_start_wizard') %>
        </a>
      </div>
      <form hx-post="/edit/<%= it.session.id %>/venue" hx-target="#venue-management">
        <div class="field label border fill">
          <input type="number" id="maxOverlaps" name="maxOverlaps" value="<%= it.session.maxOverlaps || '' %>" min="0">
          <label for="maxOverlaps"><%= it.t('max_overlaps') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('update_venue_settings') %></button>
        </div>
      </form>
    </section>

    <section id="team-management" class="padding small-round surface-variant s12 m4">
      <header>
        <h4><%= it.t('home_team_players') %></h4>
      </header>
      <ul id="player-list" class="list" aria-label="<%= it.t('home_team_players') %>">
        <% it.session.players.forEach(player => { %>
          <li>
            <i>person</i>
            <div class="max"><%= player.name %></div>
          </li>
        <% }) %>
      </ul>
      <form hx-post="/edit/<%= it.session.id %>/players" hx-target="#team-management" class="mt-4">
        <div class="field label border fill">
          <input type="text" id="playerName" name="playerName" required>
          <label for="playerName"><%= it.t('new_player_name') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('add_player') %></button>
        </div>
      </form>
    </section>

    <section id="proposed-dates-management" class="padding small-round surface-variant s12 m4">
      <header>
        <h4><%= it.t('proposed_dates_management') %></h4>
      </header>
      <ul id="proposed-date-list" class="list" aria-label="<%= it.t('proposed_dates_management') %>">
        <% it.proposedDates.forEach(proposedDate => { %>
          <li>
            <i>event</i>
            <div class="max"><%= proposedDate.display %></div>
          </li>
        <% }) %>
      </ul>
      <form hx-post="/edit/<%= it.session.id %>/proposed-dates" hx-target="#proposed-dates-management" class="mt-4">
        <div class="field label border fill">
          <input type="datetime-local" id="proposedDateTime" name="proposedDateTime"
                 value="<%= it.session.originalMatchDateTime || '' %>" required>
          <label for="proposedDateTime"><%= it.t('proposed_date_time_label') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('add_proposed_date') %></button>
        </div>
      </form>
    </section>

    <section id="vote-tally-section" class="padding small-round surface-variant s12" aria-label="<%= it.t('vote_summary') %>">
      <%~ include('../../partials/vote-tally.eta', {...it, headingLevel: 4}) %>
    </section>
  </div>
</section>
