<% layout('../../layouts/main.eta') %>

<% if (it.ownerPassword) { %>
  <div class="toast primary white-text top" role="alert">
    <i aria-hidden="true">info</i>
    <div class="max">
      <p><strong><%= it.t('reschedule_created_success') %></strong></p>
      <p><%~ it.t('owner_password_label') %> <span class="password-display"><%= it.ownerPassword %></span></p>
      <p><%= it.t('save_password_warning') %></p>
    </div>
  </div>
<% } %>

<div class="row items-center wrap">
  <p class="chip outline"><%= it.t('status_label', {status: it.session.status}) %></p>
</div>

<div>
  <p><%= it.t('invite_link_label') %></p>
  <ul class="list">
    <li class="row items-center gap wrap">
      <a href="<%= it.baseUrl %>/join/<%= it.session.id %>/home?token=<%= it.invitationPassword %>"><%= it.t('invite_link_home_label') %></a>
      <button class="clipboard-btn" data-copy="<%= it.baseUrl %>/join/<%= it.session.id %>/home?token=<%= it.invitationPassword %>" aria-label="<%= it.t('copy_to_clipboard') %>" type="button"><i>content_copy</i></button>
    </li>
    <li class="row items-center gap wrap">
      <a href="<%= it.baseUrl %>/join/<%= it.session.id %>/away?token=<%= it.invitationPassword %>"><%= it.t('invite_link_away_label') %></a>
      <button class="clipboard-btn" data-copy="<%= it.baseUrl %>/join/<%= it.session.id %>/away?token=<%= it.invitationPassword %>" aria-label="<%= it.t('copy_to_clipboard') %>" type="button"><i>content_copy</i></button>
    </li>
  </ul>
</div>

<div>
  <header>
    <h2><%= it.t('scheduling_engine_info') %></h2>
  </header>

  <div id="scheduling-info" class="grid">
    <section id="venue-management" class="padding small-round surface-variant s12 m4" aria-live="polite">
      <header>
        <h3 tabindex="-1"><%= it.t('venue_management') %></h3>
      </header>
      <div>
        <a class="button"
           href="/create/scrape">
          <%= it.t('scrape_start_wizard') %>
        </a>
      </div>
      <form hx-post="/edit/<%= it.session.id %>/venue" hx-target="#venue-management" hx-on::after-request="focusAfterSwap('#venue-management')">
        <div class="field label border fill">
          <input type="number" id="maxOverlaps" name="maxOverlaps" value="<%= it.session.maxOverlaps || '' %>" min="0">
          <label for="maxOverlaps"><%= it.t('max_overlaps') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('update_venue_settings') %></button>
        </div>
      </form>
    </section>

    <section id="team-management" class="padding small-round surface-variant s12 m4" aria-live="polite">
      <header>
        <h3 tabindex="-1"><%= it.t('players') %></h3>
      </header>

      <h5><%= it.t('home_team') %></h5>
      <ul id="home-player-list" class="list" aria-label="<%= it.t('home_team') %>">
        <% it.session.players.filter(p => p.teamId === 'home').forEach(player => { %>
          <li>
            <i>person</i>
            <div class="max"><%= player.name %></div>
          </li>
        <% }) %>
      </ul>
      <form hx-post="/edit/<%= it.session.id %>/players" hx-target="#team-management" class="mt-4" hx-on::after-request="focusAfterSwap('#team-management')">
        <input type="hidden" name="teamId" value="home">
        <div class="field label border fill">
          <input type="text" id="playerName" name="playerName" required>
          <label for="playerName"><%= it.t('new_player_name') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('add_player') %></button>
        </div>
      </form>

      <h5><%= it.t('away_team') %></h5>
      <ul id="away-player-list" class="list" aria-label="<%= it.t('away_team') %>">
        <% it.session.players.filter(p => p.teamId === 'away').forEach(player => { %>
          <li>
            <i>person</i>
            <div class="max"><%= player.name %></div>
          </li>
        <% }) %>
      </ul>
      <form hx-post="/edit/<%= it.session.id %>/players" hx-target="#team-management" class="mt-4" hx-on::after-request="focusAfterSwap('#team-management')">
        <input type="hidden" name="teamId" value="away">
        <div class="field label border fill">
          <input type="text" id="playerNameAway" name="playerName" required>
          <label for="playerNameAway"><%= it.t('new_player_name') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('add_player') %></button>
        </div>
      </form>
    </section>

    <section id="proposed-dates-management" class="padding small-round surface-variant s12 m4" aria-live="polite">
      <header>
        <h3 tabindex="-1"><%= it.t('proposed_dates_management') %></h3>
      </header>
      <ul id="proposed-date-list" class="list" aria-label="<%= it.t('proposed_dates_management') %>">
        <% it.proposedDates.forEach(proposedDate => { %>
          <li>
            <i>event</i>
            <div class="max"><%= proposedDate.display %></div>
            <label class="switch">
              <input type="checkbox"
                     hx-post="/edit/<%= it.session.id %>/proposed-date-visibility?proposedDateId=<%= proposedDate.id %>&votable=<%= !proposedDate.awayTeamVotable %>"
                     hx-target="#proposed-dates-management"
                     <%= proposedDate.awayTeamVotable ? 'checked' : '' %>>
              <span><%= it.t('away_team_votable') %></span>
            </label>
          </li>
        <% }) %>
      </ul>
      <form hx-post="/edit/<%= it.session.id %>/proposed-dates" hx-target="#proposed-dates-management" class="mt-4" hx-on::after-request="focusAfterSwap('#proposed-dates-management')">
        <div class="field label border fill">
          <input type="datetime-local" id="proposedDateTime" name="proposedDateTime"
                 value="<%= it.session.originalMatchDateTime || '' %>" required lang="de">
          <label for="proposedDateTime"><%= it.t('proposed_date_time_label') %></label>
        </div>
        <div class="right-align">
          <button type="submit"><%= it.t('add_proposed_date') %></button>
        </div>
      </form>
    </section>
  </div>

  <div id="vote-tally-section" class="grid">
    <section class="padding small-round surface-variant s12 m6" aria-label="<%= it.t('vote_summary_home') %>">
      <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_home'), proposedDates: it.homeProposedDates, t: it.t}) %>
    </section>

    <section class="padding small-round surface-variant s12 m6" aria-label="<%= it.t('vote_summary_away') %>">
      <%~ include('../../partials/vote-tally.eta', {headingLevel: 3, title: it.t('vote_summary_away'), proposedDates: it.awayProposedDates, t: it.t}) %>
    </section>
  </div>
</div>
