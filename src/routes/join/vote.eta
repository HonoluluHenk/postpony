<% layout('../layouts/main.eta') %>

<header>
  <h2><%= it.t('vote_title') %></h2>
</header>

<% if (it.updated) { %>
  <div class="toast success top" role="alert">
    <i aria-hidden="true">check_circle</i>
    <div class="max"><p><%= it.t('vote_updated') %></p></div>
  </div>
<% } %>

<% if (it.proposedDates.length === 0) { %>
  <p><%= it.t('vote_no_dates') %></p>
<% } else { %>
  <form method="post"
        action="/join/<%= it.sessionId %>/<%= it.team %>/vote?playerId=<%= it.playerId %>&token=<%= it.token %>"
        hx-boost="false" aria-label="<%= it.t('vote_title') %>">
    <% it.proposedDates.forEach(function (pd) { %>
      <fieldset class="field border">
        <legend><%= pd.display %></legend>
        <label class="radio">
          <input type="radio" name="vote-<%= pd.id %>" value="Yes"
                 <%= pd.currentVote === 'Yes' ? 'checked' : '' %> <%= it.readOnly ? 'disabled' : '' %> <%= it.readOnly ? '' : 'required' %>>
          <span><%= it.t('vote_yes') %></span>
        </label>
        <label class="radio">
          <input type="radio" name="vote-<%= pd.id %>" value="Maybe"
                 <%= pd.currentVote === 'Maybe' ? 'checked' : '' %> <%= it.readOnly ? 'disabled' : '' %>>
          <span><%= it.t('vote_maybe') %></span>
        </label>
        <label class="radio">
          <input type="radio" name="vote-<%= pd.id %>" value="No"
                 <%= pd.currentVote === 'No' ? 'checked' : '' %> <%= it.readOnly ? 'disabled' : '' %>>
          <span><%= it.t('vote_no') %></span>
        </label>
      </fieldset>
    <% }) %>

    <% if (!it.readOnly) { %>
      <div class="right-align">
        <button type="submit"><%= it.t('vote_submit') %></button>
      </div>
    <% } %>
  </form>

  <section aria-labelledby="vote-summary-title">
    <%~ include('../partials/vote-tally.eta', {...it, headingLevel: 3, titleId: 'vote-summary-title', title: it.t('vote_summary')}) %>
  </section>
<% } %>

<script>
  window.localStorage.setItem('postpony-player-<%= it.sessionId %>-<%= it.team %>', '<%= it.playerId %>');
</script>
