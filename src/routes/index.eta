<% layout('./layouts/main.eta') %>

<section class="padding small-round surface-variant">
  <header class="center-align">
    <h2><%= it.t('welcome') %></h2>
    <p><%= it.t('tagline') %></p>
  </header>

  <nav class="center-align mt-4" aria-label="<%= it.t('main_actions') %>">
    <a class="button" href="/create"><%= it.t('create_new') %></a>
    <a class="button" href="/create/scrape"><%= it.t('scrape_start_wizard') %></a>
    <a class="button outline" href="/edit"><%= it.t('edit_existing') %></a>
  </nav>
</section>
