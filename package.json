{
  "name": "game-scheduler",
  "version": "1.0.0",
  "description": "PostPony - postponing games as quick and easy as the Pony Express",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "APP_USE_FIXTURES=true tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:live": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:test": "vitest",
    "dev:lint": "tsc --noEmit --watch",
    "clean": "rimraf dist playwright-report test-results coverage",
    "build": "vite build",
    "start": "run-s -n start:*",
    "start:build": "npm run build",
    "start:start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "run-s -l lint:*",
    "lint:source": "tsc --noEmit",
    "lint:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "e2e": "run-s -n e2e:*",
    "e2e:build": "npm run build",
    "e2e:e2e": "playwright test e2e-tests",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/run-migration.ts",
    "worker:build": "wrangler deploy --dry-run --outdir dist-worker",
    "verify": "npm-run-all -l lint:* test build e2e",
    "playwright:ui": "playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@libsql/client": "^0.17.4",
    "convict": "^6.2.5",
    "hono": "^4.3.7",
    "node-html-parser": "^7.1.0",
    "pino": "^10.3.1",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/convict": "^6.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.43",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5",
    "wrangler": "^4.123.0"
  }
}
