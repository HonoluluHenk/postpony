{
  "name": "game-scheduler",
  "version": "1.0.0",
  "description": "PostPony - postponing games as quick and easy as the Pony Express",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:test": "vitest",
    "dev:lint": "tsc --noEmit --watch",
    "clean": "rimraf dist playwright-report test-results",
    "build": "vite build",
    "start": "node dist/index.js",
    "lint": "run-s -l lint:*",
    "lint:source": "tsc --noEmit",
    "lint:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test e2e-tests",
    "verify": "npm-run-all -l lint:* test build e2e",
    "playwright:ui": "playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "@js-temporal/polyfill": "^0.5.1",
    "convict": "^6.2.5",
    "eta": "^3.4.0",
    "hono": "^4.3.7",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.44.0",
    "@types/convict": "^6.1.6",
    "@types/node": "^20.12.12",
    "@vitest/ui": "^4.1.5",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
