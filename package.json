{
  "name": "game-scheduler",
  "version": "1.0.0",
  "description": "PostPony - postponing games as quick and easy as the Pony Express",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "APP_USE_FIXTURES=true tsx watch src/index.ts",
    "dev:live": "tsx watch src/index.ts",
    "dev:test": "vitest",
    "dev:lint": "tsc --noEmit --watch",
    "clean": "rimraf dist playwright-report test-results coverage",
    "build": "vite build",
    "start": "node dist/index.js",
    "lint": "run-s -l lint:*",
    "lint:source": "tsc --noEmit",
    "lint:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --max-warnings 0 --fix",
    "test": "vitest run",
    "e2e": "playwright test e2e-tests",
    "verify": "npm-run-all -l lint:* test build e2e",
    "playwright:ui": "playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^1.11.1",
    "@js-temporal/polyfill": "^0.5.1",
    "convict": "^6.2.5",
    "eta": "^3.4.0",
    "hono": "^4.3.7",
    "node-html-parser": "^7.1.0",
    "valibot": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/convict": "^6.1.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.12.12",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "lodash-es": "^4.18.1",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
